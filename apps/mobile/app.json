{
  "expo": {
    "name": "Surani and Sons",
    "slug": "surani-and-sons-stock-manager",
    "scheme": "suraniandsons",
    "version": "1.1.3",
    "orientation": "portrait",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suraniandsons.stockmanager"
    },
    "android": {
      "package": "com.suraniandsons.stockmanager",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://stock.suraniandsons.com/api"
    },
    "plugins": [
      "expo-sharing",
      "expo-notifications",
      "./plugins/withLightTheme.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Surani and Sons to attach a bill photo from your gallery to an expense.",
          "cameraPermission": "Allow Surani and Sons to photograph a bill to attach to an expense."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Surani and Sons to record your location when you sign in."
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
